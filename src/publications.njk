---
layout: base.njk
title: Publications
permalink: /publications/
---
<div class="wrap">
  <span class="eyebrow">Research &amp; writing</span>
  <h1>Publications</h1>

  <section>
    <h2>Peer-reviewed</h2>
    <ul class="entry-list">
      {% for pub in publications.peerReviewed %}
      <li class="entry">
        <div class="entry-title">
          {% if pub.url %}<a href="{{ pub.url }}" target="_blank" rel="noopener">{{ pub.title }}</a>{% else %}{{ pub.title }}{% endif %}
        </div>
        <div class="entry-meta">{{ pub.authors }} — {{ pub.venue }}{% if pub.volume %}, {{ pub.volume }}{% endif %}, {{ pub.date }}</div>
      </li>
      {% endfor %}
    </ul>
  </section>

  <section>
    <h2>wiiw Monthly Reports</h2>
    <ul class="entry-list">
      {% for pub in publications.monthlyReports %}
      <li class="entry">
        <div class="entry-title">
          {% if pub.url %}<a href="{{ pub.url }}" target="_blank" rel="noopener">{{ pub.title }}</a>{% else %}{{ pub.title }}{% endif %}
        </div>
        <div class="entry-meta">{{ pub.venue }} — {{ pub.date }}{% if pub.note %} — {{ pub.note }}{% endif %}</div>
      </li>
      {% endfor %}
    </ul>
  </section>

  <section>
    <h2>Handbooks &amp; statistical reports</h2>
    <ul class="entry-list">
      {% for pub in publications.handbooksAndReports %}
      <li class="entry">
        <div class="entry-title">{{ pub.title }}</div>
        <div class="entry-meta">{{ pub.note }} — {{ pub.date }}</div>
      </li>
      {% endfor %}
    </ul>
  </section>

  <section>
    <h2>Documents</h2>
    <p class="notice">{{ publications._comment }}</p>
    <ul class="entry-list">
      {% for doc in publications.documents %}
      <li class="entry"><div class="entry-title">{{ doc.title }}</div></li>
      {% endfor %}
    </ul>
  </section>
</div>
