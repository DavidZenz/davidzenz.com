---
layout: base.njk
title: null
theme: home
hero: true
---
<section class="hero hero--photo-right">
  <div class="hero-photo">
    <picture>
      <source type="image/avif" srcset="/assets/images/home.avif">
      <img src="/assets/images/home.jpg" alt="David Zenz" loading="eager">
    </picture>
  </div>
  <div class="hero-content">
    <span class="eyebrow">Vienna, Austria</span>
    <h1>David Zenz</h1>
    <p class="lede">{{ site.description }}</p>
  </div>
</section>

<div class="wrap--wide">
  <ul class="index-list" style="margin-top: 3rem;">
    <li>
      <a class="index-row" href="/about/">
        <span class="index-title">About</span>
        <span class="index-desc">{{ professional.role }}</span>
      </a>
    </li>
    <li>
      <a class="index-row" href="/music/">
        <span class="index-title">Music</span>
        <span class="index-desc">Drums, accordion &amp; bass across {{ music.currentProjects.length }} active bands.</span>
      </a>
    </li>
    <li>
      <a class="index-row" href="/running/">
        <span class="index-title">Running</span>
        <span class="index-desc">10k PB {{ running.pbs[1].time }}.</span>
      </a>
    </li>
    <li>
      <a class="index-row" href="/code/">
        <span class="index-title">Code</span>
        <span class="index-desc">
          {% if github.user %}{{ github.user.publicRepos }} public repos on GitHub.{% else %}Recent GitHub activity.{% endif %}
        </span>
      </a>
    </li>
    <li>
      <a class="index-row" href="/publications/">
        <span class="index-title">Publications</span>
        <span class="index-desc">Research &amp; writing at wiiw.</span>
      </a>
    </li>
  </ul>
</div>
