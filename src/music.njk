---
layout: base.njk
title: Music
permalink: /music/
theme: music
hero: true
---
<section class="hero hero--photo-right">
  <div class="hero-photo">
    <picture>
      <source type="image/avif" srcset="/assets/images/music_action2.avif">
      <img src="/assets/images/music_action2.jpg" alt="David Zenz playing bass on stage" loading="eager">
    </picture>
  </div>
  <div class="hero-content">
    <span class="eyebrow">Music</span>
    <h1>Let there be Bass, Drums &amp; Guitar</h1>
    <p class="lede">Rock 'n Roll since '99.</p>
  </div>
</section>

<section class="segment segment--photo-left">
  <div class="hero-photo">
    <picture>
      <source type="image/avif" srcset="/assets/images/music_action.avif">
      <img src="/assets/images/music_action.jpg" alt="David Zenz mid-headbang on stage" loading="lazy">
    </picture>
  </div>
  <div class="hero-content">
    {% if gigs.upcoming.length %}
    <span class="eyebrow">Upcoming gigs</span>
    <ul class="entry-list">
      {% for g in gigs.upcoming %}
      <li class="entry">
        <div class="entry-title"><a class="link-underline" href="{{ g.url }}">{{ g.venue }}{% if g.city %}, {{ g.city }}{% endif %}</a></div>
        <div class="entry-meta">{{ g.date | gigDate }} &middot; {{ g.artist }}</div>
      </li>
      {% endfor %}
    </ul>
    {% endif %}
    <span class="eyebrow">Current projects</span>
    <ul class="entry-list project-grid">
      {% for p in music.currentProjects %}
      <li class="entry">
        <div class="entry-title">{% if p.url %}<a class="link-underline" href="{{ p.url }}">{{ p.name }}</a>{% else %}{{ p.name }}{% endif %}</div>
        <div class="entry-meta">{{ p.years }}</div>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="segment segment--banner">
  <div class="hero-photo">
    <picture>
      <source type="image/avif" srcset="/assets/images/music_action3.avif">
      <img src="/assets/images/music_action3.jpg" alt="Full band on stage at a festival" loading="lazy">
    </picture>
  </div>
  <div class="hero-content">
    <span class="eyebrow">By the numbers</span>
    <div class="stat-row">
      <div class="stat"><span class="stat-value">{{ music.stats.concerts }}</span><span class="stat-label">concerts</span></div>
      <div class="stat"><span class="stat-value">{{ music.stats.albums }}</span><span class="stat-label">albums</span></div>
      <div class="stat"><span class="stat-value">{{ music.stats.videos }}</span><span class="stat-label">videos</span></div>
      <div class="stat"><span class="stat-value">{{ music.stats.songs }}</span><span class="stat-label">songs written</span></div>
    </div>
  </div>
</section>

<section class="segment segment--photo-right">
  <div class="hero-photo">
    <picture>
      <source type="image/avif" srcset="/assets/images/music_action4.avif">
      <img src="/assets/images/music_action4.jpg" alt="David Zenz performing intensely on stage" loading="lazy">
    </picture>
  </div>
  <div class="hero-content">
    <span class="eyebrow">Training</span>
    <h2>1990&ndash;2015</h2>
    <ul class="timeline">
      {% for t in music.training %}
      <li><span class="years">{{ t.years }}</span><span>{{ t.what }}, {{ t.where }}</span></li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="release-band">
  <div class="wrap--wide">
    <h2>Releases</h2>
    {% set releaseGroups = [["Album", "Albums"], ["EP", "EPs"], ['7" Single', '7" Singles'], ["Single", "Digital singles"], ["Compilation", "Compilations"]] %}
    {% for group in releaseGroups %}
    <h3 class="release-group">{{ group[1] }}</h3>
    <ul class="release-grid">
      {% for r in music.releases %}{% if r.type == group[0] %}
      <li class="release">
        {% if r.url %}<a class="release-cover" href="{{ r.url }}" tabindex="-1" aria-hidden="true">{% else %}<div class="release-cover">{% endif %}
          {% if r.cover %}
          <picture>
            <source type="image/avif" srcset="/assets/images/covers/{{ r.cover }}.avif">
            <img src="/assets/images/covers/{{ r.cover }}.jpg" alt="" width="480" height="480" loading="lazy">
          </picture>
          {% else %}
          <span class="release-cover-blank">{{ r.title }}</span>
          {% endif %}
        {% if r.url %}</a>{% else %}</div>{% endif %}
        <div class="release-title" lang="de">{% if r.url %}<a class="link-underline" href="{{ r.url }}">{{ r.title }}</a>{% else %}{{ r.title }}{% endif %}</div>
        <div class="release-meta">{{ r.artist }}{% if r.year %} &middot; {{ r.year }}{% endif %}</div>
        {% if r.role %}<div class="release-meta">{{ r.role }}</div>{% endif %}
        {% if r.note %}<div class="release-meta">{{ r.note }}</div>{% endif %}
        {% include "release-links.njk" %}
      </li>
      {% endif %}{% endfor %}
    </ul>
    {% endfor %}
  </div>
</section>

<div class="wrap">
  <section>
    <h2>Awards</h2>
    <ul class="entry-list">
      {% for a in music.awards %}
      <li class="entry award">
        {% if a.logo %}
        <picture class="award-badge award-badge--logo">
          <source type="image/avif" srcset="/assets/images/awards/{{ a.logo }}.avif">
          <img src="/assets/images/awards/{{ a.logo }}.jpg" alt="" width="350" height="350" loading="lazy">
        </picture>
        {% else %}
        {# Icons: Lucide (ISC) #}
        <span class="award-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            {% if a.icon == "trophy" %}
            <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
            {% else %}
            <path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"/><circle cx="12" cy="8" r="6"/>
            {% endif %}
          </svg>
        </span>
        {% endif %}
        <div>
          <div class="entry-title">{% if a.url %}<a class="link-underline" href="{{ a.url }}">{{ a.title }}</a>{% else %}{{ a.title }}{% endif %}</div>
          <div class="entry-meta">{{ a.year }} &middot; {{ a.artist }} &middot; {{ a.detail }}</div>
        </div>
      </li>
      {% endfor %}
    </ul>
  </section>

  <section>
    <h2>On TV</h2>
    <ul class="entry-list">
      {% for t in music.tv %}
      <li class="entry award">
        {# Icon: Lucide (ISC) #}
        <span class="award-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24"><rect width="20" height="15" x="2" y="7" rx="2" ry="2"/><polyline points="17 2 12 7 7 2"/></svg>
        </span>
        <div>
          <div class="entry-title">{% if t.url %}<a class="link-underline" href="{{ t.url }}">{{ t.title }}</a>{% else %}{{ t.title }}{% endif %}</div>
          <div class="entry-meta">{% if t.year %}{{ t.year }} &middot; {% endif %}{{ t.artist }}{% if t.channel != t.title %} &middot; {{ t.channel }}{% endif %}</div>
          {% if t.detail %}<div class="entry-meta">{{ t.detail }}</div>{% endif %}
          {% if t.videos %}<div class="entry-meta">{% for v in t.videos %}<a class="link-underline" href="{{ v }}">Video {{ loop.index }}</a>{% if not loop.last %} &middot; {% endif %}{% endfor %}</div>{% endif %}
        </div>
      </li>
      {% endfor %}
    </ul>
  </section>

  <section>
    <h2>Past projects</h2>
    <ul class="entry-list">
      {% for p in music.pastProjects %}
      <li class="entry">
        <div class="entry-title">{{ p.name }}</div>
        <div class="entry-meta">{% if p.years %}{{ p.years }}{% endif %}{% if p.role %} · {{ p.role }}{% endif %}</div>
      </li>
      {% endfor %}
    </ul>
  </section>
</div>
