---
layout: base.njk
title: Music
permalink: /music/
theme: music
hero: true
---
<section class="hero hero--photo-right">
  <div class="hero-photo">
    <picture>
      <source type="image/avif" srcset="/assets/images/music_action2.avif">
      <img src="/assets/images/music_action2.jpg" alt="David Zenz playing bass on stage" loading="eager">
    </picture>
  </div>
  <div class="hero-content">
    <span class="eyebrow">Music</span>
    <h1>Drums, accordion &amp; bass</h1>
    <p class="lede">On stage since 2004.</p>
  </div>
</section>

<section class="segment segment--photo-left">
  <div class="hero-photo">
    <picture>
      <source type="image/avif" srcset="/assets/images/music_action.avif">
      <img src="/assets/images/music_action.jpg" alt="David Zenz mid-headbang on stage" loading="lazy">
    </picture>
  </div>
  <div class="hero-content">
    <span class="eyebrow">Current projects</span>
    <h2>On stage now</h2>
    <ul class="entry-list">
      {% for p in music.currentProjects %}
      <li class="entry">
        <div class="entry-title">{% if p.url %}<a class="link-underline" href="{{ p.url }}">{{ p.name }}</a>{% else %}{{ p.name }}{% endif %}</div>
        <div class="entry-meta">{{ p.years }}</div>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="segment segment--banner">
  <div class="hero-photo">
    <picture>
      <source type="image/avif" srcset="/assets/images/music_action3.avif">
      <img src="/assets/images/music_action3.jpg" alt="Full band on stage at a festival" loading="lazy">
    </picture>
  </div>
  <div class="hero-content">
    <span class="eyebrow">By the numbers</span>
    <div class="stat-row">
      <div class="stat"><span class="stat-value">{{ music.stats.concerts }}</span><span class="stat-label">concerts</span></div>
      <div class="stat"><span class="stat-value">{{ music.stats.albums }}</span><span class="stat-label">albums</span></div>
      <div class="stat"><span class="stat-value">{{ music.stats.videos }}</span><span class="stat-label">videos</span></div>
      <div class="stat"><span class="stat-value">{{ music.stats.songs }}</span><span class="stat-label">songs written</span></div>
    </div>
    <p class="notice" style="margin-top:1.5rem;">{{ music._comment }}</p>
  </div>
</section>

<section class="segment segment--photo-right">
  <div class="hero-photo">
    <picture>
      <source type="image/avif" srcset="/assets/images/music_action4.avif">
      <img src="/assets/images/music_action4.jpg" alt="David Zenz performing intensely on stage" loading="lazy">
    </picture>
  </div>
  <div class="hero-content">
    <span class="eyebrow">Training</span>
    <h2>1990&ndash;2015</h2>
    <ul class="timeline">
      {% for t in music.training %}
      <li><span class="years">{{ t.years }}</span><span>{{ t.what }}, {{ t.where }}</span></li>
      {% endfor %}
    </ul>
  </div>
</section>

<div class="wrap">
  <section>
    <h2>Past projects</h2>
    <ul class="entry-list">
      {% for p in music.pastProjects %}
      <li class="entry">
        <div class="entry-title">{{ p.name }}</div>
        <div class="entry-meta">{% if p.years %}{{ p.years }}{% endif %}{% if p.role %} · {{ p.role }}{% endif %}</div>
      </li>
      {% endfor %}
    </ul>
  </section>
</div>
