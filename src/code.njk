---
layout: base.njk
title: Code
permalink: /code/
theme: code
hero: true
---
<section class="hero hero--photo-left">
  <div class="hero-photo">
    <picture>
      <source type="image/avif" srcset="/assets/images/code.avif">
      <img src="/assets/images/code.jpg" alt="David Zenz coding" loading="eager">
    </picture>
  </div>
  <div class="hero-content">
    <span class="eyebrow">GitHub</span>
    <h1>Code</h1>
    {% if github.user %}
    <p class="lede">{{ github.user.publicRepos }} public repos on GitHub.</p>
    {% endif %}
  </div>
</section>

<div class="wrap">
  {% if github.user %}
  <p class="lede">{{ github.user.followers }} followers on <a class="link-underline" href="{{ github.user.htmlUrl }}">GitHub</a>.</p>
  {% else %}
  <p class="notice">GitHub data unavailable at build time — try again on the next deploy.</p>
  {% endif %}

  <section>
    <h2>Shiny apps</h2>
    <ul class="entry-list">
      {% for app in shinyApps %}
      <li class="entry">
        <div class="entry-title"><a class="link-underline" href="{{ app.infoUrl }}" target="_blank" rel="noopener">{{ app.title }}</a></div>
        {% if app.appUrl != app.infoUrl %}
        <div class="entry-meta"><a class="link-underline" href="{{ app.appUrl }}" target="_blank" rel="noopener">Open app</a></div>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
  </section>

  <section>
    <h2>R packages</h2>
    <ul class="entry-list">
      {% for pkg in rPackages %}
      <li class="entry">
        <div class="entry-title"><a class="link-underline" href="{{ pkg.url }}" target="_blank" rel="noopener">{{ pkg.title }}</a></div>
        <div class="entry-meta">
          {{ pkg.description }}
          {% if pkg.url != pkg.githubUrl %}<br><a class="link-underline" href="{{ pkg.githubUrl }}" target="_blank" rel="noopener">GitHub</a>{% endif %}
        </div>
      </li>
      {% endfor %}
    </ul>
  </section>

  <section>
    <h2>Recently pushed</h2>
    <ul class="entry-list">
      {% for repo in github.repos %}
      <li class="entry">
        <div class="entry-title"><a class="link-underline" href="{{ repo.url }}">{{ repo.name }}</a></div>
        <div class="entry-meta">
          {% if repo.language %}{{ repo.language }}{% endif %}{% if repo.stars %} · ★ {{ repo.stars }}{% endif %}
          {% if repo.description %}<br>{{ repo.description }}{% endif %}
        </div>
      </li>
      {% else %}
      <li class="entry"><p class="notice">No repo data yet — run <code>npm run fetch:github</code> before building.</p></li>
      {% endfor %}
    </ul>
  </section>
</div>
