---
layout: base.njk
title: Running
permalink: /running/
theme: running
hero: true
---
<section class="hero hero--photo-right">
  <div class="hero-photo">
    <picture>
      <source type="image/avif" srcset="/assets/images/running_action.avif">
      <img src="/assets/images/running_action.jpg" alt="David Zenz running on a track" loading="eager">
    </picture>
  </div>
  <div class="hero-content">
    <span class="eyebrow">Running</span>
    <h1>Personal bests</h1>
    <p class="lede">Marathon, half, 10k, 5k.</p>
  </div>
</section>

<div class="wrap">
  <p class="notice">{{ running._comment }}</p>

  <section>
    <table>
      <thead><tr><th>Distance</th><th>Time</th><th>Note</th></tr></thead>
      <tbody>
        {% for pb in running.pbs %}
        <tr><td>{{ pb.distance }}</td><td>{{ pb.time }}</td><td>{{ pb.note }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </section>

  {% if races.races.length %}
  <section>
    <h2>Races</h2>
    <div id="race-map" data-races="{{ races.races | dump | escape }}"></div>
  </section>
  <link rel="stylesheet" href="/assets/vendor/leaflet/leaflet.css">
  <script src="/assets/vendor/leaflet/leaflet.js"></script>
  <script src="/assets/race-map.js"></script>
  {% endif %}

  <section>
    <h2>Recent activity</h2>
    <p class="notice">
      Live Strava data isn't wired in yet — it needs a one-time API app + OAuth setup on your end.
      Once you've got a client id/secret and refresh token, this section will pull recent runs
      and weekly mileage at build time, the same way the <a class="link-underline" href="/code/">Code</a> page pulls GitHub activity.
    </p>
  </section>
</div>
