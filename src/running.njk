---
layout: base.njk
title: Running
permalink: /running/
theme: running
hero: true
---
<section class="hero hero--photo-right">
  <div class="hero-photo">
    <picture>
      <source type="image/avif" srcset="/assets/images/running_action.avif">
      <img src="/assets/images/running_action.jpg" alt="David Zenz running on a track" loading="eager">
    </picture>
  </div>
  <div class="hero-content">
    <span class="eyebrow">Running</span>
    <h1>Running Journey</h1>
    <p class="lede">Ultra, Marathon, Half, 10k, 5k.</p>
  </div>
</section>

<div class="wrap">
  {% if not races.pbs.length %}<p class="notice">{{ running._comment }}</p>{% endif %}

  <section>
    <h2>Personal Bests</h2>
    <table>
      <thead><tr><th>Distance</th><th>Time</th><th>Note</th></tr></thead>
      <tbody>
        {% for pb in running.pbs | mergePbs(races.pbs) %}
        <tr><td>{{ pb.distance }}</td><td>{{ pb.time }}</td><td>{{ pb.note }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </section>

  <section>
    <h2>Stats</h2>
    {% if not runningStats.fetchedAt %}
    <p class="notice">
      Live Runalyze data isn't wired in yet — set a <code>RUNALYZE_TOKEN</code> to pull it at build time.
    </p>
    {% endif %}
    <div class="stat-row">
      <div class="stat"><span class="stat-value">{{ runningStats.distanceKm.thisWeek | commas }}</span><span class="stat-label">km this week</span></div>
      <div class="stat"><span class="stat-value">{{ runningStats.distanceKm.thisMonth | commas }}</span><span class="stat-label">km this month</span></div>
      <div class="stat"><span class="stat-value">{{ runningStats.distanceKm.thisYear | commas }}</span><span class="stat-label">km this year</span></div>
      <div class="stat"><span class="stat-value">{{ runningStats.distanceKm.total | commas }}</span><span class="stat-label">km total</span></div>
      <div class="stat"><span class="stat-value">{{ runningStats.raceCount | commas }}</span><span class="stat-label">races</span></div>
      <div class="stat"><span class="stat-value">{{ runningStats.marathonCount | commas }}</span><span class="stat-label">marathons</span></div>
      <div class="stat"><span class="stat-value">{{ runningStats.majorCount | commas }}</span><span class="stat-label">marathon majors</span></div>
    </div>
  </section>
</div>

{% if races.races.length %}
<section class="race-map-section">
  <div class="wrap"><h2>Races</h2></div>
  <div id="race-map" data-races="{{ races.races | dump | escape }}"></div>
</section>
<link rel="stylesheet" href="/assets/vendor/leaflet/leaflet.css">
<script src="/assets/vendor/leaflet/leaflet.js"></script>
<script src="/assets/vendor/topojson-client.min.js"></script>
<script src="/assets/race-map.js"></script>
{% endif %}
